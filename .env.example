# ==============================================================================
# Fluento — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and fill in your keys. NEVER commit `.env` to Git!

# Environment mode: development | staging | production
APP_ENV=development

# LLM Writing Feedback API (OpenAI / Gemini / Custom Endpoint)
LLM_API_KEY=
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Optional: Azure Speech Pronunciation Assessment (for B1-C1 Phoneme Analysis)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Optional: Backend & Analytics endpoints
BACKEND_BASE_URL=http://localhost:8080/api/v1
ENABLE_ANALYTICS=false
